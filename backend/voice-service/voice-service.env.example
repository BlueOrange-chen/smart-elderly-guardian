PORT=8010
LOG_LEVEL=INFO
DEVICE_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_TOKEN

# 与现有 unified_backend 使用相同的 DeepSeek 配置
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_PATH=/chat/completions
AI_MODEL=deepseek-v4-flash
AI_API_KEY=CHANGE_ME
AI_MAX_TOKENS=160
AI_STREAM_MAX_TOKENS=160
AI_TEMPERATURE=0.6
AI_TIMEOUT_SECONDS=45
# 可选；不设置时使用 app.py 内置的“直接与老人沟通的智能看护员”提示词
# AI_SYSTEM_PROMPT=

# 中国大陆 ECS 推荐使用阿里云百炼，无需 VPN
SPEECH_PROVIDER=dashscope
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=60
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
TTS_FORMAT=wav
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_SECONDS=60
STREAM_SAMPLE_RATE=16000

MAX_AUDIO_BYTES=10485760
MIN_AUDIO_BYTES=128
SESSION_TTL_SECONDS=1800
MAX_CONVERSATION_TURNS=6
MAX_SESSIONS=1000
TEST_AUDIO_PATH=/opt/smart-elderly-voice/public/caregiver-speaker-test.wav
