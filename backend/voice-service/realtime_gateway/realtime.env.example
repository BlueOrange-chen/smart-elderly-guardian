REALTIME_PORT=8011
DEVICE_API_TOKEN=replace-with-the-same-device-token
DASHSCOPE_API_KEY=replace-with-beijing-api-key
# 新版工作空间模式建议配置；未配置时网关会尝试兼容的公共地址。
DASHSCOPE_WORKSPACE_ID=
QWEN_REALTIME_MODEL=qwen-audio-3.0-realtime-flash
QWEN_REALTIME_VOICE=longanqian
REALTIME_VAD_THRESHOLD=0.2
REALTIME_SILENCE_MS=600
# 硬件漏发 input.end 时，最后一帧 PCM 后自动结束本轮。
REALTIME_INPUT_IDLE_MS=800
REALTIME_HISTORY_TURNS=8
DEVICE_IDLE_TIMEOUT_SECONDS=180
