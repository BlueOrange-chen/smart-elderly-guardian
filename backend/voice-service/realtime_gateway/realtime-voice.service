[Unit]
Description=Smart Elderly Care Realtime Voice Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartvoice
Group=smartvoice
WorkingDirectory=/opt/smart-elderly-realtime
EnvironmentFile=/etc/smart-elderly-voice.env
EnvironmentFile=-/etc/smart-elderly-realtime.env
Environment=REALTIME_PORT=8011
ExecStart=/opt/smart-elderly-realtime/venv/bin/python /opt/smart-elderly-realtime/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smart-elderly-realtime

[Install]
WantedBy=multi-user.target
